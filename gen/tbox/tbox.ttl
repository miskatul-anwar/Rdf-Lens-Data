ans:acquaintedWith a rdf:Property ;
    rdfs:comment "delta(e1): q(?x, ?y) :- ?z rdfs:subPropertyOf :knows, ?x ?z ?y" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:Blogger .

ans:age a rdf:Property ;
    rdfs:comment "delta(e6): q(?x, ?y) :- ?x rdf:type :Person, ?x :hasAge ?y" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:Value .

ans:classifiedAs a rdf:Property ;
    rdfs:comment "delta(e8): q(?x, ?y) :- ?x rdf:type :Product, ?x rdf:type ?y" ;
    rdfs:domain ans:Item ;
    rdfs:range ans:Type .

ans:cost a rdf:Property ;
    rdfs:comment "delta(e10): q(?x, ?y) :- ?x :hasPrice ?y" ;
    rdfs:domain ans:Item ;
    rdfs:range ans:Value .

ans:identifiedBy a rdf:Property ;
    rdfs:comment "delta(e2): q(?x, ?y) :- ?x :hasName ?y" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:Name .

ans:livesIn a rdf:Property ;
    rdfs:comment "delta(e3): q(?x, ?y) :- ?x :inCity ?y" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:City .

ans:postedOn a rdf:Property ;
    rdfs:comment "delta(e5): q(?x, ?y) :- ?x rdf:type :Message, ?x :inBlog ?y" ;
    rdfs:domain ans:BlogPost ;
    rdfs:range ans:Site .

ans:purchased a rdf:Property ;
    rdfs:comment "delta(e7): q(?x, ?y) :- ?x :bought ?y" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:Item .

ans:ratedBy a rdf:Property ;
    rdfs:comment "delta(e9): q(?x, ?y) :- ?y :gave ?z, ?z rdf:type :Rating, ?z :on ?x, ?x rdf:type :Product" ;
    rdfs:domain ans:Item ;
    rdfs:range ans:Blogger .

ans:wrotePost a rdf:Property ;
    rdfs:comment "delta(e4): q(?x, ?y) :- ?x :wrote ?y, ?y rdf:type :Message" ;
    rdfs:domain ans:Blogger ;
    rdfs:range ans:BlogPost .

ex:SmartPhone rdfs:subClassOf ex:Phone .

ex:Student rdfs:subClassOf ex:Person .

ex:bought rdfs:domain ex:Person ;
    rdfs:range ex:Product .

ex:friend rdfs:subPropertyOf ex:knows .

ex:hasAge rdfs:domain ex:Person ;
    rdfs:range xsd:int .

ex:hasBrand rdfs:domain ex:Product ;
    rdfs:range ex:Brand .

ex:hasPrice rdfs:domain ex:Product ;
    rdfs:range xsd:int .

ex:inBlog rdfs:domain ex:Message ;
    rdfs:range ex:Blog .

ex:worksWith rdfs:subPropertyOf ex:knows .

ex:wrote rdfs:domain ex:Person ;
    rdfs:range ex:Message .

