dbo:AcademicJournal a owl:Class ;
    rdfs:label "Wissenschaftliche Fachzeitschrift"@de,
        "academic journal"@en,
        "학술지"@ko ;
    rdfs:comment "Wissenschaftliche Fachzeitschriften sind regelmäßig verlegte Fachzeitschriften über Spezialthemen aus den verschiedensten wissenschaftlichen Disziplinen. Sie stellen neue Methoden, Techniken und aktuelle Trends aus den Wissenschaften dar."@de,
        "An academic journal is a mostly peer-reviewed periodical in which scholarship relating to a particular academic discipline is published. Academic journals serve as forums for the introduction and presentation for scrutiny of new research, and the critique of existing research. Content typically takes the form of articles presenting original research, review articles, and book reviews."@en ;
    rdfs:subClassOf dbo:PeriodicalLiterature .

