dbo:WorldHeritageSite a owl:Class ;
    rdfs:label "Μνημείο Παγκόσμιας Πολιτιστικής Κληρονομιάς (Πληροφορίες ΠΠΚ)"@el,
        "World Heritage Site"@en,
        "site du patrimoine mondial"@fr,
        "세계유산"@ko ;
    rdfs:comment "A UNESCO World Heritage Site is a site (such as a forest, mountain, lake, desert, monument, building, complex, or city) that is on the list that is maintained by the international World Heritage Programme administered by the UNESCO World Heritage Committee, composed of 21 state parties which are elected by their General Assembly for a four-year term. A World Heritage Site is a place of either cultural or physical significance."@en ;
    rdfs:subClassOf dbo:Place .

dbo:Writer a owl:Class ;
    rdfs:label "συγγραφέας"@el,
