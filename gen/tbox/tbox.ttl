@prefix ans: <http://example.org/ans#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbp: <http://dbpedia.org/property/> .
@prefix dt: <http://dbpedia.org/datatype/> .
@prefix ex: <http://example.org/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ans:BlogPost a rdfs:Class ;
    rdfs:comment "delta(n4): q(?x) :- ?x rdf:type :Message, ?x :inBlog ?z, ?z rdf:type :Blog" .

ans:Blogger a rdfs:Class ;
    rdfs:comment "delta(n1): q(?x) :- ?x rdf:type :Person, ?x :wrote ?y, ?y :inBlog ?z" .

ans:City a rdfs:Class ;
    rdfs:comment "delta(n3): q(?x) :- ?y :inCity ?x" .

ans:Item a rdfs:Class ;
    rdfs:comment "delta(n7): q(?x) :- ?x rdf:type ?y, ?y rdfs:subClassOf :Product" .

ans:Name a rdfs:Class ;
    rdfs:comment "delta(n2): q(?x) :- ?y :hasName ?x" .

ans:Site a rdfs:Class ;
    rdfs:comment "delta(n5): q(?x) :- ?y :inBlog ?x, ?x rdf:type :Blog" .

ans:Type a rdfs:Class ;
    rdfs:comment "delta(n8): q(?x) :- ?x rdfs:subClassOf :Product" .

ans:Value a rdfs:Class ;
    rdfs:comment "delta(n6): q(?x) :- ?z rdfs:range xsd:int, ?y ?z ?x" .

dbo: a owl:Ontology ;
    owl:versionInfo "Version 3.8"@en .

dbo:Ambassador a owl:Class ;
    rdfs:label "Botschafter"@de,
        "πρεσβευτής"@el,
        "ambassador"@en,
        "ambassadeur"@fr,
        "ambasciatore"@it ;
    rdfs:comment "An ambassador is the highest ranking diplomat that represents a nation and is usually accredited to a foreign sovereign or government, or to an international organization."@en ;
    rdfs:subClassOf dbo:Person .

dbo:AmericanFootballLeague a owl:Class ;
    rdfs:label "american football league"@en,
        "american football league"@fr,
        "liga de futebol americano"@pt ;
    rdfs:comment "A group of sports teams that compete against each other in american football."@en ;
