  <rdf:Description rdf:about="http://dbpedia.org/ontology/GovernmentAgency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">government agency</rdfs:label>
    <rdfs:label xml:lang="de">Behörde</rdfs:label>
    <rdfs:comment xml:lang="en">A government agency is a permanent or semi-permanent organization in the machinery of government that is responsible for the oversight and administration of specific functions, such as an intelligence agency.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Behörde ist eine staatliche Einrichtung, die im weitesten Sinne für die Erfüllung von Aufgaben der Verwaltung des Staates und dabei insbesondere für Dienstleistungen des Staates gegenüber seinen Bürgern zuständig ist. Eine Behörde erhält ihren Auftrag aus den Gesetzen des Staates, in dem und für den sie tätig ist.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://dbpedia.org/ontology/Organisation"/>
    <owl:equivalentClass rdf:resource="http://schema.org/GovernmentOrganization"/>
  </rdf:Description>
