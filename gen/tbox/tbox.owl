    <rdfs:label xml:lang="de">Radiosender</rdfs:label>
    <rdfs:label xml:lang="fr">station de radio</rdfs:label>
    <rdfs:label xml:lang="es">emisora de radio</rdfs:label>
    <rdfs:comment xml:lang="en">A radio station has one line up. For instance the radio station BBC Radio 1. Not to be confused with the broadcasting network BBC, which has many radio stations.</rdfs:comment>
